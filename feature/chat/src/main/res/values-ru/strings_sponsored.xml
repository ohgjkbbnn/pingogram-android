    <string name="sponsored_label">Реклама</string>
    <!-- The label of a sponsored message that recommends a channel. -->
    <string name="sponsored_label_recommended">Рекомендуем</string>
    <!-- The info button of a sponsored message's card, for screen readers, and the title of the sheet it opens. -->
    <string name="sponsored_about">О рекламе</string>
    <string name="sponsored_about_recommended">О рекомендации</string>
    <string name="sponsored_about_text">Telegram показывает рекламные сообщения в некоторых каналах и ботах. TrueGram показывает их так, как их присылает Telegram: он не выбирает и не меняет их.</string>
    <!-- Above who placed the ad (legal information from Telegram). -->
    <string name="sponsored_advertiser">Рекламодатель</string>
