    <string name="sponsored_ads_hidden">Рекламные сообщения скрыты</string>
    <string name="sponsored_premium_required">Скрывать рекламу могут только подписчики Telegram Premium</string>
    <string name="sponsored_report_failed">Не удалось отправить жалобу на рекламу</string>
    <!-- Information only: Pingogram never offers or links to Telegram Premium. -->
    <string name="sponsored_premium_note">Подписчики Telegram Premium могут отключить рекламные сообщения.</string>
