<?xml version="1.0" encoding="utf-8"?>
<!-- Secret chats in the conversation (REQUIREMENTS.md FR-E1): the header, the composer, the banner at the start, the
     self-destruct timer and the encryption key. The states shared with the chat list are in core:ui. -->
<resources>
    <!-- The lock before a secret chat's name, for screen readers. -->
    <string name="secret_chat">Секретный чат</string>

    <!-- In the composer's place while the user cannot write. -->
    <string name="composer_secret_pending">Сообщения можно отправлять, когда секретный чат будет настроен</string>
    <string name="composer_secret_closed">Этот секретный чат завершён</string>

    <!-- The banner at the start of a secret chat. %1$s is the other user's name. -->
    <string name="secret_intro_title">Сквозное шифрование</string>
    <string name="secret_intro_encrypted">Читать эти сообщения могут только вы и %1$s.</string>
    <string name="secret_intro_device">Они хранятся только на этом устройстве, а не в облаке Telegram, и их нельзя переслать.</string>
    <string name="secret_intro_timer">Включите таймер самоуничтожения, чтобы сообщения удалялись после прочтения.</string>
    <string name="secret_intro_screenshots">TrueGram блокирует скриншоты этого чата на этом устройстве.</string>

    <!-- The top bar's actions. %1$s is the timer, e.g. "30 seconds". -->
    <string name="secret_timer_button_off">Таймер самоуничтожения, выключен</string>
    <string name="secret_timer_button">Таймер самоуничтожения, %1$s</string>
    <string name="secret_key_button">Ключ шифрования</string>

    <!-- The self-destruct timer sheet. -->
    <string name="secret_timer_title">Таймер самоуничтожения</string>
    <string name="secret_timer_body">Новые сообщения удаляются на обоих устройствах через это время после прочтения.</string>
    <string name="secret_timer_off">Выкл.</string>
    <!-- Short forms on the timer button and in a bubble's time: 30s, 5m, 1h, 1d, 1w. -->
    <string name="secret_timer_short_seconds">%1$dс</string>
    <string name="secret_timer_short_minutes">%1$dм</string>
    <string name="secret_timer_short_hours">%1$dч</string>
    <string name="secret_timer_short_days">%1$dд</string>
    <string name="secret_timer_short_weeks">%1$dн</string>
    <plurals name="secret_timer_days">
        <item quantity="one">%d день</item>
        <item quantity="few">%d дня</item>
        <item quantity="many">%d дней</item>
        <item quantity="other">%d дня</item>
    </plurals>
    <plurals name="secret_timer_weeks">
        <item quantity="one">%d неделя</item>
        <item quantity="few">%d недели</item>
        <item quantity="many">%d недель</item>
        <item quantity="other">%d недели</item>
    </plurals>
    <!-- A bubble's self-destruct timer, for screen readers. %1$s is the timer, e.g. "30 seconds". -->
    <string name="chat_bubble_self_destruct">удалится через %1$s после прочтения</string>

    <!-- The encryption key sheet. %1$s is the other user's name. -->
    <string name="secret_key_title">Ключ шифрования</string>
    <string name="secret_key_image">Изображение ключа шифрования</string>
    <string name="secret_key_compare">Если это изображение и эти символы на экране у %1$s совпадают, никто другой не сможет прочитать ваши сообщения.</string>
    <string name="secret_key_pending">Ключ появится здесь, когда приложение %1$s присоединится к чату.</string>
    <string name="secret_end">Завершить секретный чат</string>
    <string name="secret_end_title">Завершить этот секретный чат?</string>
    <string name="secret_end_body">Ни один из вас больше не сможет отправлять в нём сообщения. Сообщения останутся на этом устройстве, пока вы не удалите чат.</string>
    <string name="secret_end_confirm">Завершить чат</string>
    <string name="secret_end_cancel">Отмена</string>
</resources>
