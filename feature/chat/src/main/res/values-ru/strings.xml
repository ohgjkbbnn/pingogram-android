    <!-- %3$s is the video\'s length, "0:42". -->
    <string name="attach_item_video">Видео %1$d из %2$d, %3$s</string>
    <string name="attach_item_preparing">Подготовка элемента %1$d из %2$d</string>
    <!-- A file among photos and videos: %1$s is its name. -->
    <string name="attach_item_file">Файл %1$s</string>
    <!-- The remove button of an item of the preview: %1$s is the item, "Photo 2 of 3" or a file\'s name. -->
    <string name="attach_remove">Удалить: %1$s</string>
    <!-- The button over a photo, video or file being sent that stops sending it. -->
    <string name="attach_cancel_upload">Отменить отправку</string>

    <!-- The sheet that sends the device\'s location (the attach menu\'s "Location") -->
    <string name="location_title">Отправить местоположение</string>
    <!-- Before Android asks for the location permission. -->
    <string name="location_permission_body">TrueGram использует ваше местоположение только для отправки в этом чате и только пока открыт этот экран.</string>
    <string name="location_permission_continue">Продолжить</string>
    <!-- After the user refused the permission for good: it can only be allowed in the system settings. -->
    <string name="location_permission_denied_body">Чтобы отправить местоположение, разрешите Pingogram его использовать в настройках приложения.</string>
    <string name="location_permission_settings">Открыть настройки</string>
    <string name="location_not_now">Не сейчас</string>
    <string name="location_searching">Определяем ваше местоположение…</string>
    <!-- Under a location found while a more accurate one is still being looked for. -->
    <string name="location_refining">Уточняем местоположение…</string>
    <!-- %1$s is a distance with its unit, "12 m" or "1.5 km". -->
    <string name="location_accuracy">Точность %1$s</string>
    <!-- For screen readers, the location found: %1$s its coordinates in words, %2$s its accuracy (location_accuracy). -->
    <string name="location_found_description">%1$s. %2$s</string>
    <!-- The user allowed only an approximate location (Android 12 and later), which is what is sent. -->
    <string name="location_approximate">Примерное местоположение</string>
</resources>
