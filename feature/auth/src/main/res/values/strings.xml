<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared -->
    <string name="auth_back">Back</string>
    <string name="auth_next">Next</string>
    <string name="auth_loading">Loading</string>
    <string name="auth_logging_out">Logging out…</string>
    <string name="auth_connection_waiting_for_network">Waiting for network…</string>
    <string name="auth_connection_connecting_to_proxy">Connecting to proxy…</string>
    <string name="auth_connection_connecting">Connecting…</string>
    <string name="auth_connection_updating">Updating…</string>
    <string name="auth_offline_banner">You\'re offline. TrueGram will continue as soon as you\'re back online.</string>
    <!-- %1$s: the remaining time, e.g. "5 minutes". -->
    <string name="auth_flood_wait">Too many attempts. Try again in %1$s.</string>
    <string name="auth_terms_of_service">Terms of Service</string>
    <string name="auth_privacy_policy">Privacy Policy</string>
    <!-- On the first screen, after Telegram's Terms of Service and Privacy Policy: opens Pingogram's own privacy
         policy (its website), which says what the app does with your data. -->
    <string name="auth_pingogram_privacy_policy">TrueGram\'s privacy policy</string>

    <!-- Welcome (FR-A1) -->
    <string name="auth_welcome_title" translatable="false">TrueGram</string>
    <string name="auth_welcome_tagline">A fast, private Telegram client for Android.</string>
    <string name="auth_welcome_disclaimer">TrueGram is an independent, open-source app. It isn\'t made by Telegram.</string>
    <string name="auth_start_messaging">Start messaging</string>
    <string name="auth_welcome_agreement">By continuing, you agree to Telegram\'s Terms of Service and Privacy Policy.</string>

    <!-- Phone number (FR-A2). "Calling code", the "+44" part, never "country code": some places are regions. -->
    <string name="auth_phone_title">Your phone number</string>
    <string name="auth_phone_change_title">Change phone number</string>
    <string name="auth_phone_description">Check the calling code and enter your phone number. Telegram will send you a login code.</string>
    <string name="auth_qr_login">Log in with QR code</string>
    <!-- Between the phone number step's two ways in: Next, then signing in with a passkey. -->
    <string name="auth_or">or</string>
    <string name="auth_passkey_sign_in">Sign in with a passkey</string>
    <string name="auth_passkey_note">Uses a passkey you added in Privacy and security. No code needed.</string>
    <string name="auth_passkey_not_found">No passkey for this account was found. Add one in Privacy and security once you’re signed in.</string>
    <string name="auth_passkey_unavailable">Passkeys aren’t available to Pingogram yet</string>
    <string name="auth_passkey_failed">Couldn’t sign in with a passkey. Try again.</string>

    <!-- Login code (FR-A3); %1$s is the phone number. -->
    <string name="auth_code_title">Enter the code</string>
    <string name="auth_code_open_fragment">Open Fragment</string>
    <string name="auth_change_number">Wrong number?</string>

    <!-- 2-step verification password (FR-A4) -->
    <string name="auth_password_title">Two-step verification</string>
    <string name="auth_password_description">Your account is protected with an additional password.</string>
    <string name="auth_password_label">Password</string>
    <!-- The password visibility toggle; screen readers add whether it is on. -->
    <string name="auth_password_show">Show password</string>
    <string name="auth_password_hint">Hint: %1$s</string>
    <string name="auth_forgot_password">Forgot password?</string>
    <string name="auth_password_no_recovery_email">This account has no recovery email, so its password can\'t be reset here. Try to remember it; the hint may help. Pingogram doesn\'t offer resetting the account.</string>
    <string name="auth_recovery_title">Password recovery</string>
    <string name="auth_recovery_description">We emailed a recovery code to %1$s.</string>
    <string name="auth_recovery_description_unknown">We emailed a recovery code to your recovery address.</string>
    <string name="auth_recovery_code_label">Recovery code</string>
    <string name="auth_new_password_title">New password</string>
    <string name="auth_new_password_description">The code is correct. Choose a new password for your account.</string>
    <string name="auth_new_password_label">New password</string>
    <string name="auth_new_password_confirmation_label">Repeat new password</string>
    <string name="auth_new_password_mismatch">Passwords don\'t match</string>
    <string name="auth_new_password_hint_label">Hint (optional)</string>
    <string name="auth_new_password_submit">Save and log in</string>

    <!-- Registration (FR-A5) -->
    <string name="auth_registration_title">Your name</string>
    <string name="auth_registration_description">This number has no Telegram account yet. Enter your name to create one.</string>
    <string name="auth_first_name">First name</string>
    <string name="auth_last_name">Last name (optional)</string>
    <string name="auth_accept_terms">I accept Telegram\'s Terms of Service</string>
    <string name="auth_read_terms">Read the Terms of Service</string>
    <string name="auth_create_account">Create account</string>
    <plurals name="auth_terms_min_age">
        <item quantity="one">You must be at least %d year old to use Telegram.</item>
        <item quantity="other">You must be at least %d years old to use Telegram.</item>
    </plurals>
    <string name="auth_terms_accept">Accept</string>
    <string name="auth_terms_decline">Decline</string>

    <!-- QR code login (FR-A6) -->
    <string name="auth_qr_title">Log in with QR code</string>
    <!-- The steps of Telegram's own QR login screens; "Telegram" names the user's other app (descriptive text). -->
    <string name="auth_qr_step_open">Open Telegram on your phone</string>
    <string name="auth_qr_step_settings">Go to Settings › Devices › Link Desktop Device</string>
    <string name="auth_qr_step_confirm">Point your phone at this screen to confirm login</string>
    <string name="auth_qr_code_description">QR code for logging in. Scan it with Telegram on your phone.</string>
    <string name="auth_qr_use_phone">Log in with phone number instead</string>

    <!-- Email address (FR-A7) -->
    <string name="auth_email_title">Your email address</string>
    <string name="auth_email_change_title">Change email address</string>
    <string name="auth_email_description">Telegram needs an email address for this account. You\'ll get a login code there.</string>
    <string name="auth_email_label">Email address</string>
    <string name="auth_email_code_title">Check your email</string>
    <!-- %1$s: the email address with most of it hidden, e.g. "a***@example.org". -->
    <string name="auth_email_code_description">We sent a code to %1$s.</string>
    <string name="auth_email_resend">Resend code</string>
    <string name="auth_email_change">Use a different email</string>
    <string name="auth_email_reset">Reset email address</string>
    <string name="auth_email_reset_available">Can\'t open this email? Reset it to get a code by SMS instead.</string>
    <!-- %1$s: how long a reset takes, e.g. "7 hours". -->
    <string name="auth_email_reset_wait">Can\'t open this email? You can reset it; this takes %1$s.</string>
    <string name="auth_email_reset_pending">Your email address will be reset in %1$s.</string>
    <string name="auth_email_reset_check">Check again</string>

    <!-- Telegram Premium required -->
    <string name="auth_premium_title">Telegram Premium required</string>
    <string name="auth_premium_description">Telegram lets this account log in only after buying Telegram Premium.</string>
    <string name="auth_premium_not_offered">Pingogram doesn\'t sell subscriptions. You can buy Telegram Premium in one of Telegram\'s own apps, then log in here.</string>
    <!-- %1$s: Telegram's support email address. -->
    <string name="auth_premium_support">Questions about the purchase? Write to Telegram support at %1$s.</string>
    <string name="auth_premium_contact_support">Contact support</string>
    <string name="auth_premium_change_number">Use a different number</string>
    <!-- The hidden way into the demo for app store reviewers: holding the Welcome screen's logo asks this. The demo shows sample chats stored on the phone and does not connect to Telegram. -->
    <string name="auth_demo_title">Open the demo?</string>
    <string name="auth_demo_text">It shows sample chats stored on this phone, without a Telegram account.</string>
    <string name="auth_demo_cancel">Cancel</string>
    <string name="auth_demo_open">Open</string>
</resources>
